{
  "schemaVersion": 1,
  "id": "abilitymod",
  "version": "${version}",
  "name": "Abilities",
  "description": "Give players special abilities with /ability give. Block Morph, Mob Tamer and Sabotage.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.abilitymod.AbilityMod"],
    "client": ["com.abilitymod.client.AbilityClient"]
  },
  "mixins": [
    { "config": "abilitymod.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
